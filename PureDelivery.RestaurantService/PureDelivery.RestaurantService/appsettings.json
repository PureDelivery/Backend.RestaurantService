{
  "GeneralConfig": {
    "ConfigSource": "Local",
    "ConfigPaths": {
      "RestaurantService": "configs/restaurantServiceConfig.json",
      "Redis": "configs/redisConfig.json",
      "Cloudinary": "configs/cloudinaryConfig.json",
      "Scoring": "configs/scoringConfig.json",
      "LocationService": "configs/locationServiceConfig.json",
      "HttpClient": "configs/httpclient.json",
      "DeliveryTime": "configs/deliveryTimeConfig.json"
    },
    "ConfigUrls": {
      "RestaurantService": "https://config-server.puredelivery.com/api/config/restaurant-service",
      "Redis": "https://config-server.puredelivery.com/api/config/redis",
      "Cloudinary": "https://config-server.puredelivery.com/api/config/cloudinary",
      "Scoring": "https://config-server.puredelivery.com/api/config/scoring",
      "LocationService": "https://config-server.puredelivery.com/api/config/location-service",
      "HttpClient": "https://puredelivery-config.azureconfig.io/kv/HttpClient",
      "DeliveryTime": "https://puredelivery-config.azureconfig.io/kv/DeliveryTimeConfig"

    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Service} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/identity-service-log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Service} {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=RestaurantServiceDb;Trusted_Connection=true;TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
